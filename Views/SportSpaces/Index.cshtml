@model IEnumerable<SportSpace>
@using GestionDeEspacios.Enums

@{
    ViewData["Title"] = "Gestión de Espacios Deportivos";
}

<div class="section container">

    <!-- TOAST -->
    @if (TempData["Message"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                M.toast({
                    html: '@TempData["Message"]',
                    classes: 'blue darken-3',
                    displayLength: 4000
                });
            });
        </script>
    }

    <!-- HEADER -->
    <div class="row valign-wrapper" style="margin-bottom:30px;">
        <div class="col s12 m7">
            <h4 class="blue-text text-darken-3" style="font-weight:700;">
                Gestión de Espacios
            </h4>
            <p class="grey-text">
                Administra y consulta los espacios deportivos disponibles
            </p>
        </div>
        <div class="col s12 m5 right-align">
            <a asp-action="Create"
               class="btn green darken-2 waves-effect waves-light z-depth-1">
                <i class="material-icons left">add</i>
                Nuevo
            </a>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card z-depth-1" style="border-radius:16px;">
        <div class="card-content">
            <span class="card-title" style="font-weight:600;">Filtrar</span>

            <form asp-action="FilterByType" method="get">
                <div class="row valign-wrapper" style="margin-bottom:0;">
                    
                    <div class="input-field col s12 m4">
                        <select name="type">
                            <option value="" disabled selected>Selecciona tipo</option>
                            @foreach (var type in Enum.GetValues<SportSpacesType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <label>Tipo de espacio</label>
                    </div>

                    <div class="col s6 m3">
                        <button type="submit"
                                class="btn orange darken-2 waves-effect waves-light full-width">
                            <i class="material-icons left">filter_list</i>
                            Filtrar
                        </button>
                    </div>

                    <div class="col s6 m3">
                        <a asp-action="Index"
                           class="btn grey lighten-3 black-text waves-effect full-width">
                            <i class="material-icons left">clear</i>
                            Limpiar
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card z-depth-2" style="border-radius:16px;">
        <div class="card-content">
            <span class="card-title" style="font-weight:600;">
                Lista de Espacios
            </span>

            <table class="striped highlight responsive-table centered">
                <thead class="blue darken-3 white-text">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <span class="chip blue lighten-4 blue-text text-darken-3">
                                    @item.Type
                                </span>
                            </td>
                            <td>@item.Capacity</td>

                            <td>
                                <a href="#spaceModal"
                                   class="btn-small blue darken-3 modal-trigger"
                                   onclick="showSpace('@item.Id','@item.Name','@item.Type','@item.Capacity')">
                                    <i class="material-icons">visibility</i>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-small orange darken-2">
                                    <i class="material-icons">edit</i>
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;">
                                    <button type="submit"
                                            class="btn-small red darken-2">
                                        <i class="material-icons">delete</i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>

<!-- MODAL -->
<div id="spaceModal" class="modal">
    
    <div class="modal-content">
        <div class="center-align" style="margin-bottom:20px;"> <i class="material-icons green-text text-darken-2" style="font-size:60px;">stadium</i> <h5 style="font-weight:700; margin-top:10px;">Detalle del Espacio Deportivo</h5> </div>
        <div class="divider" style="margin:15px 0 25px 0;"></div>
        <div class="row">
            <div class="col s12">
                <p><strong>Nombre:</strong></p> <span id="viewName" class="grey-text text-darken-2"></span> </div>
            <div class="col s12" style="margin-top:15px;">
                <p><strong>Tipo:</strong></p> <span id="viewType" class="grey-text text-darken-2"></span> </div>
            <div class="col s12" style="margin-top:15px;">
                <p><strong>Capacidad:</strong></p> <span id="viewCapacity" class="grey-text text-darken-2"></span> </div> </div> </div>
    <div class="modal-footer"> <a href="#!" class="modal-close btn grey lighten-3 black-text waves-effect"> Cerrar </a> </div>
</div>

