@{
    ViewData["Title"] = "Inicio";
}

<section class="section">

    <!-- HERO -->
    <div class="card-panel z-depth-0 blue darken-4 white-text" style="border-radius:20px; padding:50px;">
        <div class="row valign-wrapper" style="margin-bottom:0;">
            <div class="col s12 m8">
                <h3 style="font-weight:700;">Gestiona tus espacios deportivos fácilmente</h3>
                <p class="flow-text" style="opacity:.9;">
                    Administra reservas, usuarios y canchas desde un solo lugar.
                    Optimiza horarios, evita conflictos y mejora la experiencia
                    de tus clientes o miembros deportivos.
                </p>

                <div style="margin-top:30px;">
                    <a asp-controller="Reservation" asp-action="Index"
                       class="btn-large white blue-text text-darken-4 waves-effect waves-light"
                       style="border-radius:12px; margin-right:10px;">
                        Reservar Ahora
                    </a>

                    <a asp-controller="SportSpaces" asp-action="Index"
                       class="btn-large transparent white-text waves-effect waves-light"
                       style="border:1px solid white; border-radius:12px;">
                        Ver Espacios
                    </a>
                </div>
            </div>

            <div class="col m4 hide-on-small-only center-align">
                <i class="material-icons" style="font-size:170px; opacity:.25;">
                    sports_soccer
                </i>
            </div>
        </div>
    </div>

    <!-- QUICK ACCESS -->
   <div class="section">
    <h4 class="center-align" style="font-weight:700;">Accesos rápidos</h4>
    <p class="center-align grey-text text-darken-1">
        Navega rápidamente a los módulos principales
    </p>

    <div class="row">

        <!-- RESERVAS -->
        <div class="col s12 m6 l4">
            <div class="card hoverable" style="border-radius:18px;">
                <div class="card-content center-align">
                    <i class="material-icons blue-text text-darken-3" style="font-size:55px;">event</i>
                    <span class="card-title">Reservas</span>
                    <p>Consulta y administra horarios disponibles.</p>
                </div>
                <div class="card-action center-align">
                    <a asp-controller="Reservation" asp-action="Index"
                       class="btn blue darken-3 waves-effect">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- ESPACIOS -->
        <div class="col s12 m6 l4">
            <div class="card hoverable" style="border-radius:18px;">
                <div class="card-content center-align">
                    <i class="material-icons green-text text-darken-2" style="font-size:55px;">stadium</i>
                    <span class="card-title">Espacios</span>
                    <p>Gestiona canchas, zonas y disponibilidad.</p>
                </div>
                <div class="card-action center-align">
                    <a asp-controller="SportSpaces" asp-action="Index"
                       class="btn green darken-2 waves-effect">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- USUARIOS -->
        <div class="col s12 m6 offset-m3 l4 offset-l0">
            <div class="card hoverable" style="border-radius:18px;">
                <div class="card-content center-align">
                    <i class="material-icons orange-text text-darken-3" style="font-size:55px;">group</i>
                    <span class="card-title">Usuarios</span>
                    <p>Administra clientes y miembros registrados.</p>
                </div>
                <div class="card-action center-align">
                    <a asp-controller="User" asp-action="Index"
                       class="btn orange darken-3 waves-effect">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

    <!-- BENEFITS -->
    <div class="section">
        <div class="row">

            <div class="col s12 m4">
                <div class="card-panel center-align" style="border-radius:18px;">
                    <i class="material-icons blue-text text-darken-3" style="font-size:45px;">schedule</i>
                    <h5>Control Horario</h5>
                    <p>Evita cruces de reservas y mejora la organización.</p>
                </div>
            </div>

            <div class="col s12 m4">
                <div class="card-panel center-align" style="border-radius:18px;">
                    <i class="material-icons green-text text-darken-2" style="font-size:45px;">verified</i>
                    <h5>Gestión Segura</h5>
                    <p>Información clara y organizada en tiempo real.</p>
                </div>
            </div>

            <div class="col s12 m4">
                <div class="card-panel center-align" style="border-radius:18px;">
                    <i class="material-icons orange-text text-darken-2" style="font-size:45px;">trending_up</i>
                    <h5>Mayor Productividad</h5>
                    <p>Administra más rápido y con menos errores.</p>
                </div>
            </div>

        </div>
    </div>

</section>